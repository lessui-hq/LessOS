[Unit]
Description=LessOS Boot Service
After=rocknix-autostart.service

[Service]
Type=simple
Environment=HOME=/storage
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir
# Note: lessos-boot sources /etc/profile itself for full shell environment
ExecStart=/usr/bin/lessos-boot
WorkingDirectory=/storage
Restart=always
RestartSec=2

[Install]
WantedBy=rocknix.target
