From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LessOS Build System <build@lessos>
Date: Sun, 29 Dec 2024 18:30:00 +0000
Subject: [PATCH] Fix _FILE_OFFSET_BITS configure flag

The configure script unconditionally sets -D_FILE_OFFSET_BITS=${ac_cv_sys_file_offset_bits}
which can be empty or "no" on 64-bit systems where large file support is native.
This causes a compile error. Only add the flag if it's actually set to a numeric value.
---
 configure.ac | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index 1111111..2222222 100644
--- a/configure.ac
+++ b/configure.ac
@@ -19,7 +19,9 @@ AC_CHECK_FUNCS([memset strtoll])

 # Check for LFS
 AC_SYS_LARGEFILE
-CFLAGS="$CFLAGS -D_FILE_OFFSET_BITS=${ac_cv_sys_file_offset_bits}"
+if test "$ac_cv_sys_file_offset_bits" != "no" && test -n "$ac_cv_sys_file_offset_bits"; then
+  CFLAGS="$CFLAGS -D_FILE_OFFSET_BITS=${ac_cv_sys_file_offset_bits}"
+fi

 dnl libparted
 # hack
--
